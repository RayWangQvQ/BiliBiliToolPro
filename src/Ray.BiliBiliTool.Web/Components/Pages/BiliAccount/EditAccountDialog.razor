@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_cookieStr" Label="Cookie 字符串" Lines="5" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@string.IsNullOrWhiteSpace(_cookieStr)">保存</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string CookieStr { get; set; } = "";

    private string _cookieStr = "";

    protected override void OnInitialized() => _cookieStr = CookieStr;

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(_cookieStr));
}
