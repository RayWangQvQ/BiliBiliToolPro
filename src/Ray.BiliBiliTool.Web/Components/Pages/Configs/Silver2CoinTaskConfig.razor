@page "/Configurations/Silver2CoinTaskConfig"
@using Microsoft.AspNetCore.Authorization
@using Ray.BiliBiliTool.Config.Options;
@attribute [Authorize]
@rendermode InteractiveServer
@inherits BaseConfigComponent<Silver2CoinTaskOptions>

<PageTitle>银瓜子兑换硬币任务配置</PageTitle>

<MudContainer Class="app-config-page">
    <PageHero Size="Size.Small" Title="银瓜子兑换硬币任务配置" Description="设置银瓜子兑换硬币的开关与执行选项。" />
    <Ray.BiliBiliTool.Web.Components.Comps.TaskGuide TaskKey="Silver2CoinTaskAppService" Enabled="@(_isLoading ? (bool?)null : _config.IsEnable)" />

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <EditForm Model="@_config" OnValidSubmit="HandleValidSubmitAsync">
            <DataAnnotationsValidator />

            <!-- 基础配置卡片 -->
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">基础配置</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSwitch T="bool" @bind-Value="_config.IsEnable"
                                Label="启用任务" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <Ray.BiliBiliTool.Web.Components.Comps.ScheduleTimePicker @bind-Value="_config.Cron"
                                For="@(() => _config.Cron)" Disabled="!_config.IsEnable" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- 操作按钮 -->
            <MudCard Class="mt-4">
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">保存配置</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoadConfigAsync" Class="ml-2">重新加载</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>

        @if (_saveMessage.HasValue)
        {
            <MudAlert Severity="@(_saveSuccess ? Severity.Success : Severity.Error)" Class="mt-3">
                @_saveMessage
            </MudAlert>
        }
    }
</MudContainer>
