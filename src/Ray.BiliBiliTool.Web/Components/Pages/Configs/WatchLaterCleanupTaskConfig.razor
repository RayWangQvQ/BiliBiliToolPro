@page "/Configurations/WatchLaterCleanupTaskConfig"
@using Microsoft.AspNetCore.Authorization
@using Ray.BiliBiliTool.Config.Options;
@using Ray.BiliBiliTool.Web.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inherits BaseConfigComponent<WatchLaterCleanupTaskOptions>

<PageTitle>稍后再看清理配置</PageTitle>

<MudContainer Class="app-config-page">
    <PageHero Size="Size.Small" Title="稍后再看清理配置" Description="设置稍后再看列表的清理范围、判定阈值与备份方式。" />
    <Ray.BiliBiliTool.Web.Components.Comps.TaskGuide TaskKey="WatchLaterCleanupAppService" Enabled="@(_isLoading ? (bool?)null : _config.IsEnable)" />

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <EditForm Model="@_config" OnValidSubmit="HandleValidSubmitAsync">
            <DataAnnotationsValidator />

            <!-- 基础配置卡片 -->
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">基础配置</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSwitch T="bool" @bind-Value="_config.IsEnable"
                                Label="启用任务" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <Ray.BiliBiliTool.Web.Components.Comps.ScheduleTimePicker @bind-Value="_config.Cron"
                                For="@(() => _config.Cron)" Disabled="!_config.IsEnable" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- 详细配置卡片 -->
            @if (_config.IsEnable)
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">详细配置</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool" @bind-Value="_config.OnlyViewed"
                                    Label="只清理已看完" Color="Color.Primary"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("WatchLaterCleanupAppService", "OnlyViewed"))" />
                                <MudSwitch T="bool" @bind-Value="_config.DeleteInvalid"
                                    Label="同时删除失效视频" Color="Color.Primary" Class="mt-3"
                                    HelperText="被 UP 主删除或不可播放的条目会一并清理。" />

                                <MudNumericField T="double" @bind-Value="_config.ViewedThreshold" Label="已看完判定阈值"
                                    Min="0" Max="1" Step="0.01" Class="mt-3"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("WatchLaterCleanupAppService", "ViewedThreshold"))" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool" @bind-Value="_config.UseHistoryCrossCheck"
                                    Label="用历史记录交叉判断" Color="Color.Primary"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("WatchLaterCleanupAppService", "UseHistoryCrossCheck"))" />

                                <MudNumericField T="int" @bind-Value="_config.HistoryMaxPages" Label="历史记录最多拉取页数"
                                    Min="0" Class="mt-3"
                                    HelperText="每页 30 条，0 表示不限（会更慢）。" />

                                <MudNumericField T="int" @bind-Value="_config.DeleteIntervalMs" Label="删除间隔（毫秒）"
                                    Min="0" Step="100" Class="mt-3"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("WatchLaterCleanupAppService", "DeleteIntervalMs"))" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool" @bind-Value="_config.BackupBeforeClean"
                                    Label="清理前备份" Color="Color.Primary"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("WatchLaterCleanupAppService", "BackupBeforeClean"))" />

                                <MudNumericField T="int" @bind-Value="_config.BackupRetentionDays" Label="备份保留天数"
                                    Min="0" Class="mt-3"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("WatchLaterCleanupAppService", "BackupRetentionDays"))" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField T="string" @bind-Value="_config.BackupDirectory" Label="备份目录"
                                    HelperText="相对于程序运行目录，默认为 backup。" />

                                <MudNumericField T="int" @bind-Value="_config.PageSize" Label="每页条数"
                                    Min="1" Max="50" Class="mt-3"
                                    HelperText="请求稍后再看列表时的分页大小，接口上限为 50。" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }

            <!-- 操作按钮 -->
            <MudCard Class="mt-4">
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">保存配置</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoadConfigAsync" Class="ml-2">重新加载</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>

        @if (_saveMessage.HasValue)
        {
            <MudAlert Severity="@(_saveSuccess ? Severity.Success : Severity.Error)" Class="mt-3">
                @_saveMessage
            </MudAlert>
        }
    }
</MudContainer>
