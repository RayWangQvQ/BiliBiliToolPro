@page "/Configurations/LiveLotteryTaskConfig"
@using Microsoft.AspNetCore.Authorization
@using Ray.BiliBiliTool.Config.Options;
@using Ray.BiliBiliTool.Web.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inherits BaseConfigComponent<LiveLotteryTaskOptions>

<PageTitle>直播抽奖任务配置</PageTitle>

<MudContainer>
    <PageHero Size="Size.Small" Title="直播抽奖任务配置" Description="设置直播抽奖的开关与执行选项。" />
    <Ray.BiliBiliTool.Web.Components.Comps.TaskGuide TaskKey="LiveLotteryTaskAppService" Enabled="@(_isLoading ? (bool?)null : _config.IsEnable)" />

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <EditForm Model="@_config" OnValidSubmit="HandleValidSubmitAsync">
            <DataAnnotationsValidator />
            <Ray.BiliBiliTool.Web.Components.Comps.UnsavedChangesGuard HasChanges="HasChanges" Busy="_isSaving" SaveBeforeLeaving="SaveBeforeLeavingAsync" />

            <!-- 基础配置卡片 -->
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">基础配置</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSwitch T="bool" @bind-Value="_config.IsEnable"
                                Label="启用任务" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <Ray.BiliBiliTool.Web.Components.Comps.ScheduleTimePicker @bind-Value="_config.Cron"
                                For="@(() => _config.Cron)" Disabled="!_config.IsEnable" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- 详细配置卡片 -->
            @if (_config.IsEnable)
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">详细配置</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField Immediate="true" T="string" @bind-Value="_config.ExcludeAwardNames" Label="排除的奖品名称关键字"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("LiveLotteryTaskAppService", "ExcludeAwardNames"))" />

                                <MudTextField Immediate="true" T="string" @bind-Value="_config.IncludeAwardNames" Label="包含的奖品名称关键字" Class="mt-3"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("LiveLotteryTaskAppService", "IncludeAwardNames"))" />

                                <MudSwitch T="bool" @bind-Value="_config.AutoGroupFollowings"
                                    Label="抽奖后自动分组" Color="Color.Primary" Class="mt-3" />
                                <Ray.BiliBiliTool.Web.Components.Comps.TaskSettingHelp TaskKey="LiveLotteryTaskAppService" SettingKey="AutoGroupFollowings" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField Immediate="true" T="string" @bind-Value="_config.DenyUids" Label="主播 UID 黑名单"
                                    HelperText="@(TaskHelpCatalog.SettingDescription("LiveLotteryTaskAppService", "DenyUids"))" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }

            <!-- 操作按钮 -->
            <MudCard Class="mt-4">
                <MudCardActions Class="save-actions">
                    <Ray.BiliBiliTool.Web.Components.Comps.SaveChangesButton ButtonType="ButtonType.Submit" HasChanges="HasChanges" Busy="_isSaving" Saved="_saveSuccess" />
                    <Ray.BiliBiliTool.Web.Components.Comps.RestoreConfigButton HasChanges="HasChanges" Busy="_isSaving" OnRestore="RestoreConfigAsync" />
                </MudCardActions>
            </MudCard>
        </EditForm>

        @if (_saveMessage is not null && (!HasChanges || !_saveSuccess))
        {
            <MudAlert Severity="@(_saveSuccess ? Severity.Success : Severity.Error)" Class="mt-3">
                @_saveMessage
            </MudAlert>
        }
    }
</MudContainer>
