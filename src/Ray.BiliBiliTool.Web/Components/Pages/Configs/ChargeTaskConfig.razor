@page "/Configurations/ChargeTaskConfig"
@using Microsoft.AspNetCore.Authorization
@using Ray.BiliBiliTool.Config.Options;
@using Ray.BiliBiliTool.Web.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inherits BaseConfigComponent<ChargeTaskOptions>

<PageTitle>免费B币券充电任务配置</PageTitle>

<MudContainer>
    <PageHero Size="Size.Small" Title="免费B币券充电任务配置" Description="设置充电任务的开关与执行选项。" />
    <Ray.BiliBiliTool.Web.Components.Comps.TaskGuide TaskKey="ChargeTaskAppService" Enabled="@(_isLoading ? (bool?)null : _config.IsEnable)" />

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <EditForm Model="@_config" OnValidSubmit="HandleValidSubmitAsync">
            <DataAnnotationsValidator />
            <Ray.BiliBiliTool.Web.Components.Comps.UnsavedChangesGuard HasChanges="HasChanges" Busy="_isSaving" SaveBeforeLeaving="SaveBeforeLeavingAsync" />

            <!-- 基础配置卡片 -->
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">基础配置</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSwitch T="bool" @bind-Value="_config.IsEnable"
                                Label="启用任务" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <Ray.BiliBiliTool.Web.Components.Comps.ScheduleTimePicker @bind-Value="_config.Cron"
                                For="@(() => _config.Cron)" Disabled="!_config.IsEnable" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- 详细配置卡片 -->
            @if (_config.IsEnable)
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">详细配置</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField Immediate="true" T="string" @bind-Value="_config.ChargeComment" Label="充电后留言"
                                              HelperText="@(TaskHelpCatalog.SettingDescription("ChargeTaskAppService", "ChargeComment"))" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool" Value="_isSpecifyUpToggled" ValueChanged="OnSpecifyUpToggled"
                                           Label="指定充电对象" Color="Color.Primary" />
                                <Ray.BiliBiliTool.Web.Components.Comps.TaskSettingHelp TaskKey="ChargeTaskAppService" SettingKey="SpecifyUp" />
                                @if (_isSpecifyUpToggled)
                                {
                                    <div>
                                        <div style="display: flex; align-items: end; gap: 8px;">
                                            <MudTextField Immediate="true" T="string" @bind-Value="_config.AutoChargeUpId" Label="充电 UP 主 UID"
                                                          HelperText="填写接收充电的 UP 主 UID，留空或 -1 使用项目预设对象" Class="mt-3" style="flex: 1;"/>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                                                       OnClick="() => SetSupportAuthor()" Class="mt-3" style="white-space: nowrap;">
                                                支持作者
                                            </MudButton>
                                        </div>
                                    </div>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }

            <!-- 操作按钮 -->
            <MudCard Class="mt-4">
                <MudCardActions Class="save-actions">
                    <Ray.BiliBiliTool.Web.Components.Comps.SaveChangesButton ButtonType="ButtonType.Submit" HasChanges="HasChanges" Busy="_isSaving" Saved="_saveSuccess" />
                    <Ray.BiliBiliTool.Web.Components.Comps.RestoreConfigButton HasChanges="HasChanges" Busy="_isSaving" OnRestore="RestoreConfigAsync" />
                </MudCardActions>
            </MudCard>
        </EditForm>

        @if (_saveMessage is not null && (!HasChanges || !_saveSuccess))
        {
            <MudAlert Severity="@(_saveSuccess ? Severity.Success : Severity.Error)" Class="mt-3">
                @_saveMessage
            </MudAlert>
        }
    }
</MudContainer>
