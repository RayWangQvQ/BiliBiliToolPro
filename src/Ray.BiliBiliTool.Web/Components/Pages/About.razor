@page "/about"
@rendermode InteractiveServer
@using Ray.BiliBiliTool.Web.Services
@using ConfigConstants = Ray.BiliBiliTool.Config.Constants
@inject IAppInfoProvider AppInfoProvider

<PageTitle>关于</PageTitle>

<PageHero Size="Size.Small" Title="关于 BiliTool" Description="了解项目版本、源码与反馈渠道。" />

<div class="app-about-grid">
    <MudCard Class="app-about-card">
        <MudCardHeader>
            <MudText Typo="Typo.h6">项目信息</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6" Class="app-version">版本号：@AppInfoProvider.AppVersion</MudText>
                <MudText Typo="Typo.body2">
                    B 站每日任务自动化工具。多宿主（面板 / 命令行 / 云函数），开源免费。
                </MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    版本号由 CI 在构建时注入，显示「开发版」说明非 CI 构建产物。
                </MudAlert>
            </MudStack>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Href="@ConfigConstants.SourceCodeUrl" Target="_blank"
                       StartIcon="@Icons.Material.Filled.Code">源码仓库</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       Href="@(ConfigConstants.SourceCodeUrl + "/issues")" Target="_blank"
                       StartIcon="@Icons.Material.Filled.BugReport">问题反馈</MudButton>
        </MudCardActions>
    </MudCard>

    <MudCard Class="app-about-card">
        <MudCardHeader>
            <MudText Typo="Typo.h6">赞助</MudText>
        </MudCardHeader>
        <MudCardContent Class="d-flex flex-column align-center">
            <MudText Typo="Typo.body1" Class="font-weight-bold text-center">
                开源不易，扫码赞助 1 元。每一笔赞助，都是投给理想世界的一票！
            </MudText>
            <img src="images/donate.jpg" alt="赞助码（微信 / 支付宝）" class="donate-qr align-self-center" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 text-center">
                想加入交流群的朋友，赞助时请在留言中留下你的微信号。
            </MudText>
        </MudCardContent>
    </MudCard>
</div>
