@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IBrowserViewportService BrowserViewportService
@implements IDisposable
@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1" Fixed="true">
        @* Rendered below Md only: at Md and up the drawer is persistent and needs no toggle. *@
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Class="d-flex d-md-none"
                       OnClick="ToggleDrawer" Color="Color.Inherit"
                       HtmlAttributes="@(new Dictionary<string, object> { { "title", "菜单" } })"/>
        <MudText Typo="Typo.h6" Class="ml-3">BiliTool</MudText>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.Brightness4"
                       OnClick="ToggleDarkMode" Color="Color.Inherit"
                       HtmlAttributes="@(new Dictionary<string, object> { { "title", "切换暗色模式" } })"/>
        <MudButton Href="about" Color="Color.Inherit">关于项目</MudButton>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/auth/logout" Color="Color.Inherit">退出登录</MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    @* Responsive drawer: persistent (pushes content) at Md and up, overlay below Md.
       ClipMode.Always keeps the app bar full width and puts the drawer underneath it.
       Width needs a CSS unit - MudBlazor writes it verbatim into --mud-drawer-width-left. *@
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always"
               Anchor="Anchor.Start" Elevation="1" Width="250px">
        @* Body is an explicit flex column: the nav list takes the free space and scrolls,
           the version footer keeps its own height at the bottom. *@
        <div class="app-drawer-body">
            <MudNavMenu Class="app-drawer-nav">
                <NavMenu/>
            </MudNavMenu>
            <AppVersionFooter/>
        </div>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

@code {
    private bool _isDarkMode;
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Navigating must not leave the overlay drawer covering the new page.
        _ = CloseDrawerOnNavigationAsync();
    }

    private async Task CloseDrawerOnNavigationAsync()
    {
        if (!_drawerOpen)
        {
            return;
        }

        // Xs/Sm are the breakpoints below Md, where the drawer is an overlay instead of persistent.
        var breakpoint = await BrowserViewportService.GetCurrentBreakpointAsync();
        if (breakpoint is not (Breakpoint.Xs or Breakpoint.Sm))
        {
            return;
        }

        _drawerOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private MudTheme _theme => new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976D2",
            Secondary = "#42A5F5",
            AppbarBackground = "#1976D2",
            Background = "#f5f7fa",
            Surface = "#ffffff",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#42A5F5",
            AppbarBackground = "#1f1f1f",
            Background = "#121212",
            Surface = "#1e1e1e",
            DrawerBackground = "#1a1a1a",
        },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var stored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bilitool-dark");
        var dark = stored is "1" or "true";
        if (dark != _isDarkMode)
        {
            _isDarkMode = dark;
            StateHasChanged();
        }
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        JSRuntime.InvokeVoidAsync("localStorage.setItem", "bilitool-dark", _isDarkMode ? "1" : "0");
    }
}
