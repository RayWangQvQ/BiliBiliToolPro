@using Ray.BiliBiliTool.Web.Services

@* Nav links only - the app-version footer lives in MainLayout, at the drawer bottom. *@

<MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
    首页
</MudNavLink>

<MudNavLink Href="BiliAccount" Icon="@Icons.Material.Filled.People">
    账号管理
</MudNavLink>

<MudNavLink Href="Today" Icon="@Icons.Material.Filled.CheckBox">
    今日任务
</MudNavLink>

<MudNavLink Href="Schedules" Icon="@Icons.Material.Filled.CalendarMonth">
    计划任务
</MudNavLink>

<MudNavGroup Title="任务配置" Icon="@Icons.Material.Filled.Tune">
    <MudNavLink Href="Configurations/NotificationConfig" Icon="@Icons.Material.Filled.NotificationsActive">
        检查与提醒
    </MudNavLink>
    @foreach (var task in TaskCatalog.All)
    {
        <MudNavLink @key="task.TaskKey" Href="@TaskHelpCatalog.ConfigurationUrl(task.TaskKey)" Icon="@TaskIcon(task.TaskKey)">
            @task.DisplayName
        </MudNavLink>
    }
</MudNavGroup>

<MudNavLink Href="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings">
    管理员
</MudNavLink>

@code {
    private static string TaskIcon(string taskKey) => taskKey switch
    {
        "DailyTaskAppService" => Icons.Material.Filled.Paid,
        "MangaTaskAppService" => Icons.Material.Filled.Book,
        "MangaPrivilegeTaskAppService" => Icons.Material.Filled.MenuBook,
        "Silver2CoinTaskAppService" => Icons.Material.Filled.SwapHoriz,
        "ChargeTaskAppService" => Icons.Material.Filled.Bolt,
        "VipPrivilegeTaskAppService" => Icons.Material.Filled.Star,
        "VipBigPointAppService" => Icons.Material.Filled.MilitaryTech,
        "LiveLotteryTaskAppService" => Icons.Material.Filled.CardGiftcard,
        "LiveFansMedalAppService" => Icons.Material.Filled.Badge,
        "UnfollowBatchedTaskAppService" => Icons.Material.Filled.PersonRemove,
        _ => Icons.Material.Filled.TaskAlt,
    };
}
