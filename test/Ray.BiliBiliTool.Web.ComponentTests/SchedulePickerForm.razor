@using Microsoft.AspNetCore.Components.Forms
@using Ray.BiliBiliTool.Web.Components.Comps
<EditForm Model="@Settings" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ScheduleTimePicker @bind-Value="Settings.Cron" For="@(() => Settings.Cron)" Disabled="Disabled" />
    <button type="submit">保存</button>
</EditForm>
@code {
    [Microsoft.AspNetCore.Components.Parameter] public string InitialCron { get; set; } = "0 0 15 * * ?";
    [Microsoft.AspNetCore.Components.Parameter] public bool Disabled { get; set; }
    public ScheduleSettings Settings { get; } = new();
    public int SaveCount { get; private set; }
    protected override void OnInitialized() => Settings.Cron = InitialCron;
    private void Save() => SaveCount++;
    public sealed class ScheduleSettings { public string? Cron { get; set; } }
}
